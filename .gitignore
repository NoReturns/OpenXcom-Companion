# Dependencies
node_modules/

# Secrets and local environment
.env
.env.*
*.pem
*.key

# Ping worker local state
.aster-ping-state/
**/.aster-ping-state/

# Briefing sidecar local state
.briefing-sidecar-state/
**/.briefing-sidecar-state/

# Command relay sidecar local state
.command-relay-sidecar-state/
**/.command-relay-sidecar-state/

# Shared GitHub rate-limit gate (cross-process runtime)
.relay-github-rate-limit-gate.json
**/.relay-github-rate-limit-gate.json
.relay-github-rate-limit-gate.json.merge.lock
**/.relay-github-rate-limit-gate.json.merge.lock
.command-relay-sidecar.lock

# Publisher / worker runtime output
*.log
logs/
*.journal.json
**/journal.json

# Caches and temp files
.cache/
.tmp/
*.tmp
.DS_Store
Thumbs.db

# M1-34E isolated GitHub config (local secrets / test repo name)
